<view class="page">
 <view wx:if="{{page==='home'}}">
  <text class="greeting">从一次揉泥开始</text>
  <view class="hero"><image src="/assets/pottery-hands.jpg" mode="aspectFill"/><view class="hero-copy"><text class="hero-title">揉泥基础</text><text class="hero-sub">观察手法，感受节奏</text><button class="primary" data-page="training" bindtap="navigate">开始学习</button></view></view>
  <view class="device-strip" data-page="device" bindtap="navigate"><image src="/assets/glove-open.jpg" mode="aspectFill"/><view><text class="bold">我的手套</text><text class="small status">{{s.device.connected?'已连接':'待连接'}}</text></view><image class="icon" src="/assets/caret.png"/></view>
  <text class="section-title">练习路径</text><view class="path"><view data-page="training" bindtap="navigate"><image src="/assets/play.png"/><text>观看示范</text><text class="small">学习规范动作</text></view><view data-page="calibrate" bindtap="navigate"><image src="/assets/gear.png"/><text>校准手套</text><text class="small">适配你的手型</text></view><view bindtap="start"><image src="/assets/chart.png"/><text>开始练习</text><text class="small">实时动作指导</text></view></view>
  <text class="section-title">最近练习</text><view wx:if="{{s.reports.length}}" class="record" data-id="{{s.reports[0].id}}" bindtap="reportTap"><image src="/assets/pottery-hands.jpg" mode="aspectFill"/><view><text class="bold">揉泥基础</text><text class="small">{{s.reports[0].displayDate}} · {{s.reports[0].displayDuration}}</text></view><image class="icon" src="/assets/caret.png"/></view><view wx:else class="empty">从今天起，留下你的练习足迹<button bindtap="start">开始第一次练习</button></view>
 </view>
 <view wx:elif="{{page==='device'}}"><view wx:if="{{usingHost}}" class="card"><text class="section-title">电脑主机手套</text><text class="small">{{s.hardware.connected ? '主机已连接' : '请先在电脑连接手套'}} · {{s.hardware.sampleFresh ? '采样更新中' : '暂无连续采样'}}</text><text class="small">硬件模式：{{s.hardware.mode === 0 ? '采集0' : s.hardware.mode === 1 ? '识别1' : '待确认'}}</text><view class="actions"><button disabled="{{busy || !s.hardware.connected}}" data-command="MODE 0" bindtap="hardwareCommand">采集模式</button><button disabled="{{busy || !s.hardware.connected}}" data-command="MODE 1" bindtap="hardwareCommand">识别模式</button></view><view class="actions"><button disabled="{{busy || !s.hardware.connected || s.hardware.canControl === false || s.session}}" data-command="CALIB_MIN" bindtap="hardwareCommand">手套标定握拳</button><button disabled="{{busy || !s.hardware.connected || s.hardware.canControl === false || s.session}}" data-command="CALIB_MAX" bindtap="hardwareCommand">手套标定张开</button></view><button disabled="{{busy || !s.hardware.connected || s.hardware.canControl === false}}" data-command="SAVE" bindtap="hardwareCommand">保存到手套</button><text class="small">下方个人校准和手势仍是软件参考，暂未与硬件模板同步。</text></view><view class="glove-card"><image src="/assets/glove-open.jpg" mode="aspectFill"/><view><text class="title">陶艺手套</text><text class="status">{{s.device.connected?'已连接':'待连接'}}</text><text class="small">让每一次动作被看见</text></view></view><view class="card"><text class="section-title">手指状态</text><view class="bars"><view wx:for="{{fingers}}" wx:key="name"><view class="track"><view style="height:{{item.percent}}%"/></view><text>{{item.name}}</text></view></view></view><view class="list"><view class="row" data-page="calibrate" bindtap="navigate"><image src="/assets/gear.png"/><text>手套校准</text><image class="caret" src="/assets/caret.png"/></view><view class="row" data-page="gestures" bindtap="navigate"><image src="/assets/hand.png"/><text>手势管理</text><image class="caret" src="/assets/caret.png"/></view><view class="row" bindtap="voice"><image src="/assets/voice.png"/><text>语音提示</text><switch checked="{{s.settings.voice}}" color="#3f7258" disabled/></view></view><button wx:if="{{s.device.connected}}" class="outline" bindtap="disconnect">断开连接</button><button wx:else class="primary" loading="{{busy}}" bindtap="connect">连接手套</button><button class="text-button" bindtap="settings">连接设置</button></view>
 <view wx:elif="{{page==='calibrate'}}"><view class="steps"><text class="active">1 佩戴检查</text><text class="active">2 握拳</text><text class="{{s.calibration.completed?'active':''}}">3 张开</text></view><image class="calibration-image" src="{{s.calibration.fist &amp;&amp; !s.calibration.completed?'/assets/glove-open.jpg':'/assets/glove-fist.jpg'}}" mode="aspectFill"/><text class="center title">{{s.calibration.completed?'校准完成，准备练习':s.calibration.fist?'张开五指，保持稳定':'轻轻握拳，保持稳定'}}</text><text class="center muted">让手套适应你的手型</text><view class="bars"><view wx:for="{{fingers}}" wx:key="name"><view class="track"><view style="height:{{item.percent}}%"/></view><text>{{item.name}}</text></view></view><button wx:if="{{s.calibration.completed}}" class="primary" data-page="gestures" bindtap="navigate">管理参考手势</button><button wx:else class="primary" loading="{{busy}}" bindtap="calibration">{{s.calibration.fist?'采集张开姿态':'采集握拳姿态'}}</button><button class="outline" bindtap="resetCalibration">重新采集握拳</button></view>
 <view wx:elif="{{page==='training'}}"><view class="training-head"><text class="title">揉泥基础</text><text>{{elapsed}}</text></view><video class="video" src="/assets/lesson-{{video}}.mp4" poster="/assets/pottery-hands.jpg" controls/><view class="video-tabs"><text class="{{video===0?'active':''}}" data-index="0" bindtap="setVideo">正面示范</text><text class="{{video===1?'active':''}}" data-index="1" bindtap="setVideo">侧面示范</text><text class="{{video===2?'active':''}}" data-index="2" bindtap="setVideo">近景示范</text></view><view class="card"><text class="title">{{s.session?s.feedback.text:'观察手法，准备练习'}}</text><text class="muted">{{s.device.connected?'按自己的节奏，感受手指的变化':'观看示范，也可以先记录自主练习'}}</text><view class="bars"><view wx:for="{{fingers}}" wx:key="name"><view class="track"><view style="height:{{item.percent}}%"/></view><text>{{item.name}}</text></view></view></view><view class="steps"><text class="active">准备</text><text class="{{s.session?'active':''}}">练习</text><text>完成</text></view><view wx:if="{{s.session}}" class="actions"><button class="outline" bindtap="pause">{{s.session.paused?'继续':'暂停'}}</button><button class="primary" bindtap="finish">结束练习</button></view><button wx:else class="primary" bindtap="start">开始练习</button></view>
 <view wx:elif="{{page==='report' &amp;&amp; report}}"><view class="report-lesson"><image src="/assets/pottery-hands.jpg" mode="aspectFill"/><view><text class="title">揉泥基础</text><text class="small">{{report.displayDate}}</text></view></view><text class="report-title">这一次，更从容</text><view class="stats"><view><text>练习时长</text><text>{{report.displayDuration}}</text></view><view><text>采集帧数</text><text>{{report.sampleCount}}</text></view><view><text>姿态匹配</text><text>{{report.sampleCount?report.matches:'—'}}</text></view></view><view class="card"><text class="section-title">姿态匹配记录</text><view wx:if="{{report.sampleCount}}" class="timeline"><view wx:for="{{report.timeline}}" wx:key="index" class="{{item.matched?'match':'adjust'}}"/></view><text wx:else class="muted">本次未采集手套数据，已保存自主练习时长。</text></view><view class="card"><text class="section-title">练习建议</text><view class="advice"><image src="/assets/bulb.png"/><text>先放慢节奏，再保持连贯</text></view><view class="advice"><image src="/assets/file.png"/><text>重新佩戴手套后，记得校准</text></view></view><view class="actions"><button class="primary" data-page="training" bindtap="navigate">再练一次</button><button class="outline" data-page="history" bindtap="navigate">查看历史</button></view></view>
 <view wx:elif="{{page==='history'}}"><view class="profile" bindtap="settings"><image src="/assets/user.png"/><view><text class="title">{{s.settings.learner}}</text><text class="small">在手与泥土之间，遇见更好的自己</text></view></view><view class="card"><text class="section-title">近7日练习</text><view class="week"><view wx:for="{{week}}" wx:key="index"><view style="height:{{item.height}}rpx"/><text>{{item.day}}</text></view></view></view><text class="section-title">练习记录</text><view wx:for="{{s.reports}}" wx:key="id" class="record" data-id="{{item.id}}" bindtap="reportTap"><image src="/assets/pottery-hands.jpg" mode="aspectFill"/><view><text class="bold">{{item.lesson}}</text><text class="small">{{item.displayDate}} · {{item.displayDuration}}</text></view><image class="icon" src="/assets/caret.png"/></view><view wx:if="{{!s.reports.length}}" class="empty">每一次练习，都值得留下<button bindtap="start">开始第一次练习</button></view><view class="row" data-page="calibrate" bindtap="navigate"><image src="/assets/gear.png"/><text>个人校准</text><image class="caret" src="/assets/caret.png"/></view><view class="row" bindtap="settings"><image src="/assets/voice.png"/><text>语音设置</text><image class="caret" src="/assets/caret.png"/></view></view>
 <view wx:elif="{{page==='gestures'}}"><text class="muted">保持一个清晰的动作，将它留作练习参考。</text><view wx:for="{{s.templates}}" wx:key="id" class="card"><text class="title">{{item.name}}</text><text class="small">{{item.kind==='correct'?'正确姿态':'待纠正姿态'}} · 容差 {{item.tolerance}}</text></view><view class="card"><text class="section-title">录入参考手势</text><input placeholder="例如 揉泥准备姿态" value="{{gestureName}}" bindinput="gestureInput"/><view class="actions"><button class="{{gestureKind==='correct'?'primary':'outline'}}" data-kind="correct" bindtap="gestureKind">正确姿态</button><button class="{{gestureKind==='incorrect'?'primary':'outline'}}" data-kind="incorrect" bindtap="gestureKind">待纠正姿态</button></view><button class="primary" loading="{{busy}}" bindtap="recordGesture">采集并保存</button></view></view>
 <view wx:elif="{{page==='settings'}}"><view class="card"><text class="section-title">个人设置</text><text class="label">学习者名称</text><input value="{{form.learner}}" data-key="learner" bindinput="input"/><text class="label">匹配容差</text><input type="number" value="{{form.tolerance}}" data-key="tolerance" bindinput="input"/></view><view class="card"><text class="section-title">连接设置</text><text class="label">蓝牙服务 UUID</text><input value="{{form.serviceUUID}}" data-key="serviceUUID" bindinput="input" placeholder="填写设备提供的 UUID"/><text class="label">通知特征 UUID</text><input value="{{form.notifyUUID}}" data-key="notifyUUID" bindinput="input" placeholder="填写设备提供的 UUID"/><text class="label">工作台服务地址</text><input value="{{serverURL}}" bindinput="serverInput" placeholder="留空使用本机记录"/><text class="small">连接同一工作台后，可共享训练进度和学习记录。</text></view><button class="primary" loading="{{busy}}" bindtap="saveSettings">保存设置</button></view>
 <view class="tabs"><view class="{{page==='home'?'active':''}}" data-page="home" bindtap="navigate"><image src="/assets/home.png"/><text>学习</text></view><view class="{{page==='device'?'active':''}}" data-page="device" bindtap="navigate"><image src="/assets/hand.png"/><text>设备</text></view><view class="{{page==='history'?'active':''}}" data-page="history" bindtap="navigate"><image src="/assets/user.png"/><text>我的</text></view></view>
 <view wx:if="{{showDevices}}" class="overlay"><view class="dialog"><text class="title">选择手套</text><button wx:for="{{devices}}" wx:key="deviceId" data-index="{{index}}" bindtap="selectDevice">{{item.name||item.localName}}</button><button bindtap="closeDevices">取消</button></view></view>
</view>
